# ================= StockLab 配置 =================
# 复制为 .env 后按需修改。全部项都有合理默认值，最简情况下留空即可跑起来。

# ---------- 访问 ----------
# 对外端口（NAS 上映射的端口）
SL_HOST_PORT=8787
# 访问令牌。局域网可留空；只要做了公网映射/内网穿透，强烈建议设置一串随机字符
SL_ACCESS_TOKEN=

# ---------- 数据源 ----------
# 顺序即优先级。实测成功率：腾讯/新浪 ~100%，东财 push2 仅 ~42%（间歇断连）。
# 所以主源用腾讯，东财只在需要「主力净流入」等独有字段时按需补充。
SL_SOURCE_ORDER=tencent,eastmoney,sina,alphavantage
# ---------- Alpha Vantage（可选）----------
# 实测支持：美股行情/日线/财务、A股行情/日线；不支持港股与A股财务。
# 注意：一次请求只能查一只标的，免费额度很紧。系统把它排在源顺序末位，
# 只在前面的源全部失败时才兜底，并有每日额度计数器防止烧穿。
SL_ALPHAVANTAGE_KEY=
SL_ALPHAVANTAGE_DAILY_LIMIT=25
SL_ALPHAVANTAGE_QUOTE_TTL=300
SL_ALPHAVANTAGE_KLINE_TTL=21600
# 免费额度含「每秒 1 次」限制，两次请求间强制留间隔
SL_ALPHAVANTAGE_MIN_INTERVAL=1.2
SL_ALPHAVANTAGE_BURST_WAIT=3.0

# 字段补充源（best-effort，失败不影响主流程）
SL_ENRICH_SOURCES=eastmoney
SL_ENRICH_RETRIES=1
# 字段补充的时间预算（秒），超时直接放弃，保证详情页响应速度
SL_ENRICH_BUDGET=0.9
# 单个数据源取 K线的墙钟预算（秒）。超时立刻降级到下一个源。
# 没有这道闸门时，东财 push2his 被限流会让首次加载白等 13 秒才落到腾讯。
SL_KLINE_SOURCE_BUDGET=2.5
SL_HTTP_TIMEOUT=12
SL_HTTP_RETRIES=4
# 重试退避基数（秒），实际间隔 = 基数 * 2^次数 + 抖动
SL_HTTP_BACKOFF=0.6
# 东财有频控，两次请求之间的最小间隔（秒）。网络环境差可调大到 0.3
SL_MIN_REQUEST_INTERVAL=0.18

# 缓存时长（秒）：行情短、K线长。行情 5 秒是盘中刷新的合理值
SL_QUOTE_CACHE_TTL=5
SL_KLINE_CACHE_TTL=900
SL_SNAPSHOT_CACHE_TTL=60

# ---------- 定时任务 ----------
SL_SCHEDULER_ENABLED=1
# 盘后自动同步自选股K线的时间（逗号分隔，24小时制）
SL_EOD_TIMES=15:30,18:00
# 盘中提醒巡检间隔（秒），0 表示关闭
SL_INTRADAY_INTERVAL=60

# ---------- AI 研究简报（可选）----------
# 不填 API Key 时自动使用「本地规则引擎」生成结构化简报，功能不缺失
SL_AI_ENABLED=0
# 任何 OpenAI 兼容接口都行：
#   DeepSeek  https://api.deepseek.com/v1
#   通义千问   https://dashscope.aliyuncs.com/compatible-mode/v1
#   Kimi      https://api.moonshot.cn/v1
#   本地Ollama http://192.168.1.x:11434/v1
SL_AI_BASE_URL=https://api.deepseek.com/v1
SL_AI_API_KEY=
SL_AI_MODEL=deepseek-chat
# 大模型调用超时（秒）
SL_AI_TIMEOUT=120

# ---------- 消息推送（可选，留空即禁用该渠道）----------
# 企业微信群机器人 Webhook 完整地址
SL_NOTIFY_WECOM=
# Telegram
SL_NOTIFY_TG_TOKEN=
SL_NOTIFY_TG_CHAT=
# Server酱 SendKey
SL_NOTIFY_SERVERCHAN=
# Bark 推送地址，如 https://api.day.app/你的Key
SL_NOTIFY_BARK=
# 通用 Webhook（POST JSON: {title, content, source}）
SL_NOTIFY_WEBHOOK=

# ---------- 回测成本参数 ----------
# 佣金费率（万2.5）
SL_COMMISSION=0.00025
# 印花税（千0.5，仅卖出）
SL_STAMP_TAX=0.0005
# 滑点
SL_SLIPPAGE=0.0005
# 回测默认初始资金
SL_INITIAL_CASH=100000

# ---------- 高级 / 容器内部 ----------
# 以下通常不用改：Dockerfile 与 compose 已设好
# SL_HOST=0.0.0.0
# SL_PORT=8787
# SL_DATA_DIR=/data
# SL_TZ=Asia/Shanghai

# ---------- 调试 ----------
SL_DEBUG=0
